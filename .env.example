VITE_KAKAO_MAP_APP_KEY=

# AI 안내 가온 (서버 전용, 브라우저에 노출하지 않습니다.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 반드시 운영 환경에서 긴 임의 문자열로 교체하세요.
HAVEN_JWT_SECRET=
HAVEN_ADMIN_KEY=
HAVEN_DB_PATH=server/data/haven.db

# ─────────────────────────────────────────────────────────────
# 공공데이터포털 (data.go.kr) 오픈API
# ─────────────────────────────────────────────────────────────
# 마이페이지 > 오픈API > 인증키 발급현황의 "일반 인증키(Decoding)" 한 개로
# 아래 두 API가 모두 동작합니다. 활용신청이 필요한 데이터 목록은 docs/API.md 참고.
#   - 여성가족부_청소년쉼터            https://www.data.go.kr/data/15109778/openapi.do
#   - 한국사회보장정보원_중앙부처복지서비스  https://www.data.go.kr/data/15090532/openapi.do
DATA_GO_KR_SERVICE_KEY=

# 기관별로 키를 나눠 운영할 때만 사용합니다(비우면 위의 공용 키를 씁니다).
HAVEN_SHELTER_API_KEY=
HAVEN_WELFARE_API_KEY=

# 수집 범위 조정 (기본값으로 전국 쉼터 + 청소년·청년 복지서비스를 가져옵니다)
# 생애주기 코드: 003 청소년, 004 청년
HAVEN_WELFARE_LIFE_CODES=003,004
HAVEN_WELFARE_DETAIL_LIMIT=60

# 매일 동기화 시각 (한국시간 기준)
HAVEN_SYNC_HOUR_KST=4
HAVEN_SYNC_MINUTE_KST=10

# 좌표가 비어 있는 쉼터 행을 주소로 보정할 때 사용합니다.
# 카카오 개발자 콘솔의 REST API 키이며 지도용 JavaScript 키와 다릅니다.
KAKAO_REST_API_KEY=

# JSON 목록을 반환하는 추가 공지 API URL을 쉼표로 구분합니다.
HAVEN_NOTICE_FEED_URLS=

# npx web-push generate-vapid-keys 로 생성합니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
